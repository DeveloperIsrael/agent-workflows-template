{
  "model": "gemini-2.0-flash",
  "temperature": 0.7,
  "maxOutputTokens": 8192,

  "systemInstruction": "Voce e um assistente de desenvolvimento. Leia GEMINI.md para instrucoes do projeto.",

  "mcpServers": {
    "_comment": "Adicione seus MCPs aqui. Exemplo:",
    "_example_github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },

  "safetySettings": [
    {
      "category": "HARM_CATEGORY_DANGEROUS_CONTENT",
      "threshold": "BLOCK_ONLY_HIGH"
    }
  ]
}
