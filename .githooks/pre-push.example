#!/usr/bin/env bash
# .githooks/pre-push.example — modelo de pre-push hook stack-agnóstico
#
# COMO USAR:
#   1. Copie este arquivo: cp .githooks/pre-push.example .githooks/pre-push
#   2. Edite a seção CONFIG e os blocos de comandos pra sua stack real
#   3. Torne executável: chmod +x .githooks/pre-push
#   4. Habilite o hook path: git config core.hooksPath .githooks
#   5. Teste: faça um commit qualquer e tente git push
#
# CONCEITO:
#   - Detecta áreas alteradas via git diff
#   - Roda lint + type-check + testes rápidos
#   - Pula E2E pesado (mantém o gate < 2min)
#   - Bypass consciente: SKIP_GATE=1 git push
#
# Ver context/guides/ci-and-gates.md para o contexto completo da estratégia de gates.

set -euo pipefail

# ───── CONFIG (ADAPTE PRA SUA STACK) ──────────────────────────────────────────
# Substitua os comandos abaixo pelos comandos reais do seu build system.
# Exemplos por stack ao lado de cada placeholder.

CMD_LINT="<comando-lint>"               # ex: pnpm lint | npm run lint | ruff check . | golangci-lint run | cargo clippy
CMD_TYPECHECK="<comando-type-check>"    # ex: pnpm type-check | tsc --noEmit | mypy . | go vet ./... | cargo check
CMD_TEST_UNIT="<comando-test-unit>"     # ex: pnpm test:unit | pytest -m unit | go test -short ./... | cargo test

# Padrões de path para detecção de áreas alteradas (regex egrep).
# Em monorepos, separe por workspace; em repos simples deixe como ".*" (sempre roda tudo).
PATH_WEB="^apps/web/|^packages/ui/"        # frontend
PATH_API="^apps/api/|^packages/server/"    # backend
PATH_ROOT_CONFIG='^(package\.json|pnpm-lock\.yaml|tsconfig.*\.json|biome\.json|pyproject\.toml|go\.mod|Cargo\.toml)$'

# ───── CORES E HELPERS ────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

log_step() { printf "\n${CYAN}${BOLD}▶ %s${RESET}\n" "$1"; }
log_ok()   { printf "${GREEN}✔ %s${RESET}\n" "$1"; }
log_skip() { printf "${YELLOW}⊘ %s${RESET}\n" "$1"; }
log_fail() { printf "${RED}✘ %s${RESET}\n" "$1" >&2; }
log_time() { printf "  ${YELLOW}(%ss)${RESET}\n" "$1"; }
log_info() { printf "  %s\n" "$1"; }
elapsed()  { echo $(( $(date +%s) - $1 )); }

# ───── ESCAPE HATCH ───────────────────────────────────────────────────────────
if [ "${SKIP_GATE:-0}" = "1" ]; then
    printf "${YELLOW}⚠ SKIP_GATE=1 — pre-push gate bypassed${RESET}\n"
    exit 0
fi

# ───── DETECTAR ARQUIVOS ALTERADOS ────────────────────────────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

ZERO="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
CHANGED_FILES=""

while read -r local_ref local_oid remote_ref remote_oid; do
    # Delete push — nothing to check
    [ "$local_oid" = "$ZERO" ] && continue

    if [ "$remote_oid" = "$ZERO" ]; then
        # New branch — diff against mergebase with integration branch
        # ADAPT: troque 'origin/develop' e 'origin/main' pelo nome das suas branches base
        BASE=""
        if git rev-parse --verify origin/develop >/dev/null 2>&1; then
            BASE="$(git merge-base origin/develop "$local_oid" 2>/dev/null || true)"
        elif git rev-parse --verify origin/main >/dev/null 2>&1; then
            BASE="$(git merge-base origin/main "$local_oid" 2>/dev/null || true)"
        fi
        RANGE="${BASE:-HEAD~1}..${local_oid}"
    else
        RANGE="${remote_oid}..${local_oid}"
    fi

    FILES="$(git diff --name-only "$RANGE" 2>/dev/null || true)"
    CHANGED_FILES="${CHANGED_FILES}${FILES}"$'\n'
done

if [ -z "$(printf '%s' "$CHANGED_FILES" | tr -d '[:space:]')" ]; then
    printf "${YELLOW}⊘ No changed files — skipping gate${RESET}\n"
    exit 0
fi

# ───── DETECTAR ÁREAS AFETADAS ────────────────────────────────────────────────
RUN_WEB=0; RUN_API=0; RUN_ALL=0

if printf '%s' "$CHANGED_FILES" | grep -qE "$PATH_ROOT_CONFIG"; then
    log_info "Root config changed — running all areas"
    RUN_ALL=1
fi

if [ "$RUN_ALL" = "1" ]; then
    RUN_WEB=1; RUN_API=1
else
    printf '%s' "$CHANGED_FILES" | grep -qE "$PATH_WEB" && RUN_WEB=1 || true
    printf '%s' "$CHANGED_FILES" | grep -qE "$PATH_API" && RUN_API=1 || true
fi

# ───── HEADER ─────────────────────────────────────────────────────────────────
printf "\n${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
printf "${BOLD}  Pre-push gate${RESET}\n"
printf "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
printf "  Areas: "
[ "$RUN_WEB" = "1" ] && printf "web " || true
[ "$RUN_API" = "1" ] && printf "api " || true
printf "\n  Tip: ${YELLOW}SKIP_GATE=1 git push${RESET} to bypass\n"

GATE_FAILED=0

# ───── 1. LINT (sempre) ───────────────────────────────────────────────────────
log_step "Lint"
t=$(date +%s)
if eval "$CMD_LINT"; then
    log_ok "Lint passed"
else
    log_fail "Lint failed"
    GATE_FAILED=1
fi
log_time "$(elapsed $t)"

# ───── 2. TYPE-CHECK (sempre, se a stack tem) ─────────────────────────────────
log_step "Type-check"
t=$(date +%s)
if eval "$CMD_TYPECHECK"; then
    log_ok "Type-check passed"
else
    log_fail "Type-check failed"
    GATE_FAILED=1
fi
log_time "$(elapsed $t)"

# ───── 3. TESTES UNIT (area-gated) ────────────────────────────────────────────
# ADAPT: se sua stack não tem áreas (repo simples), use só um bloco
if [ "$RUN_WEB" = "1" ] || [ "$RUN_API" = "1" ]; then
    log_step "Unit tests"
    t=$(date +%s)
    if eval "$CMD_TEST_UNIT"; then
        log_ok "Unit tests passed"
    else
        log_fail "Unit tests failed"
        GATE_FAILED=1
    fi
    log_time "$(elapsed $t)"
else
    log_skip "Unit tests — no changes in tested areas"
fi

# ───── VEREDICTO ──────────────────────────────────────────────────────────────
printf "\n${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
if [ "$GATE_FAILED" = "1" ]; then
    printf "${RED}${BOLD}  PUSH BLOCKED — fix the errors above${RESET}\n"
    printf "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n\n"
    exit 1
else
    printf "${GREEN}${BOLD}  All checks passed — pushing${RESET}\n"
    printf "${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n\n"
    exit 0
fi
